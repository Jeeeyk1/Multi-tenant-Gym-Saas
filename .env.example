# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# Local dev port map — everything sits in the 9000 range (9000 itself is skipped: Zscaler and other tools commonly hold it) so it never collides with other projects:
#   9001 API, 9002 web, 9003 admin, 9004 landing, 9005 Expo/Metro, 9006 Postgres, 9007 Redis

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
POSTGRES_DB=gym_saas
POSTGRES_PORT=9006

# Constructed from the values above.
# Pool sizing (Prisma): connection_limit is PER PROCESS. On the all-in-one CPX31 we run
# 2 Node workers → 2 × 10 = 20 connections, well under Postgres max_connections (100).
# If you split Postgres onto its own box and scale workers, keep (workers × limit) < max_connections
# with headroom for psql/migrations/crons. pool_timeout = seconds a query waits for a free connection.
DATABASE_URL=postgresql://gym_user:gym_password@localhost:9006/gym_saas?connection_limit=10&pool_timeout=15&connect_timeout=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=9007
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@localhost:9007

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=9001
API_PREFIX=api/v1
# Allowed browser origins for CORS + WebSocket (web, admin, landing).
CORS_ORIGINS=http://localhost:9002,http://localhost:9003,http://localhost:9004

# ─── Billing (manual payment instructions shown to gym owners) ────────────────
# Optional — displayed on the owner payment screen. e.g. a GCash number/name, bank details.
BILLING_GCASH=
BILLING_BANK=

# ─── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:9001/api/v1

# ─── Mobile (Expo) ────────────────────────────────────────────────────────────
# On a physical device, replace localhost with your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:9001/api/v1
EXPO_PUBLIC_LANDING_URL=http://localhost:9004

# ─── Auth (required) ──────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# scripts/setup-local.sh fills these in automatically when it creates .env.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (Resend — required to boot) ────────────────────────────────────────
# Any non-empty value lets the API start; emails only send with a real key.
RESEND_API_KEY=re_local_placeholder
EMAIL_FROM=hello@getversolutions.com
# Base URL used in links inside emails (owner/member activation).
WEB_URL=http://localhost:9002

# Members must accept the chat community rules before posting. Turn on once the web and mobile
# builds that show the rules are live (older apps can't accept them).
COMMUNITY_RULES_ENFORCED=false
# Landing site, linked from member welcome emails.
LANDING_URL=http://localhost:9004
# Shown in the admin console's internal bar: production, staging or development
CONSOLE_ENV=development
# Inbox notified of every landing page free-trial request. Leave empty to skip the email.
LEADS_NOTIFY_EMAIL=hello@getversolutions.com

# ─── AI / media (optional — features degrade without them) ────────────────────
AI_PROVIDER=groq
AI_API_KEY=
# Optional model override. Default for Groq is openai/gpt-oss-120b (llama-3.3-70b-versatile was shut down 2026-08-16).
# AI_MODEL=
# Reasoning effort for gpt-oss models on Groq (low | medium | high). Reasoning tokens count
# against each feature's max_tokens, so higher effort can cut answers off.
# AI_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
