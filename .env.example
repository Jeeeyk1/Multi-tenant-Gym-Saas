# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=gym_password
POSTGRES_DB=gym_saas
POSTGRES_PORT=5432

# Constructed from the values above.
# Pool sizing (Prisma): connection_limit is PER PROCESS. On the all-in-one CPX31 we run
# 2 Node workers → 2 × 10 = 20 connections, well under Postgres max_connections (100).
# If you split Postgres onto its own box and scale workers, keep (workers × limit) < max_connections
# with headroom for psql/migrations/crons. pool_timeout = seconds a query waits for a free connection.
DATABASE_URL=postgresql://gym_user:gym_password@localhost:5432/gym_saas?connection_limit=10&pool_timeout=15&connect_timeout=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@localhost:6379

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3001
API_PREFIX=api

# ─── Billing (manual payment instructions shown to gym owners) ────────────────
# Optional — displayed on the owner payment screen. e.g. a GCash number/name, bank details.
BILLING_GCASH=
BILLING_BANK=

# ─── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
