{
  "expo": {
    "name": "FitOps",
    "slug": "gym-saas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gymSaasMobile",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymSaas.mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "FitOps reads your workout calories and heart rate so you can track your fitness progress.",
        "NSHealthUpdateUsageDescription": "FitOps saves your workout sessions to Apple Health."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "com.gymSaas.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan member QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
