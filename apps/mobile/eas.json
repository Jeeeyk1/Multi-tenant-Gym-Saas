{
  "cli": {
    "version": ">= 16.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:9001/api",
        "EXPO_PUBLIC_LANDING_URL": "http://localhost:9004"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "REPLACE_WITH_STAGING_API_URL",
        "EXPO_PUBLIC_LANDING_URL": "REPLACE_WITH_STAGING_LANDING_URL"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "REPLACE_WITH_PRODUCTION_API_URL",
        "EXPO_PUBLIC_LANDING_URL": "REPLACE_WITH_PRODUCTION_LANDING_URL"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
