{
  "brand": {
    "navy": "#0A2540",
    "signalBlue": "#3B82F6",
    "codeBlue": "#1D4ED8",
    "codeBlueHover": "#1E40AF",
    "sky": "#93C5FD",
    "blueTint": "#DBEAFE",
    "volt": "#CCFF00",
    "_notes": {
      "signalBlue": "Logo dot, highlights, charts. Not for small white text (3.7:1).",
      "codeBlue": "Buttons, links, active states. White text on it is 6.7:1.",
      "volt": "Energy accent: marketing (on Navy or near-black only) and the default member-app accent. Never on white, never with white text, never in the staff UI."
    }
  },
  "font": {
    "display": "Manrope, Inter, system-ui, sans-serif",
    "ui": "Inter, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace",
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "scale": {
      "display": {
        "size": 48,
        "lineHeight": 52,
        "family": "display",
        "weight": 800,
        "tracking": "-0.03em"
      },
      "heading": {
        "size": 32,
        "lineHeight": 38,
        "family": "display",
        "weight": 800,
        "tracking": "-0.03em"
      },
      "title": {
        "size": 22,
        "lineHeight": 28,
        "family": "display",
        "weight": 700,
        "tracking": "-0.02em"
      },
      "body": {
        "size": 16,
        "lineHeight": 24,
        "family": "ui",
        "weight": 400
      },
      "label": {
        "size": 14,
        "lineHeight": 20,
        "family": "ui",
        "weight": 500
      },
      "eyebrow": {
        "size": 12,
        "lineHeight": 16,
        "family": "ui",
        "weight": 600,
        "tracking": "0.16em",
        "transform": "uppercase"
      }
    }
  },
  "radius": {
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 16,
    "pill": 999,
